extends RefCounted
const CATEGORIES=["Личные дневники","Научные отчёты","Сообщения","Документы","Архив наблюдения"]
const ENTRIES={
 "med_chart": {"category":1,"title":"Ответ не равен восстановлению","author":"Ирина Сомова · врач-реаниматолог","date":"Смена 214 · 06:40","body":"V-17 реагирует на обращение по фамилии. Это первый устойчивый ответ за трое суток. Повторила вопрос без подсказки — реакция сохранилась.\n\nВ электронной карте появился статус «стабилизация завершена». Я его не выставляла. Самостоятельное дыхание ещё нестабильно, нагрузку на правую руку мы даже не проверяли. Исправление статуса отклонено: у моего профиля теперь нет соответствующего допуска.\n\nОставляю бумажную копию возле капсулы. Если смена придёт раньше меня: не путайте открытые глаза с готовностью пациента встать. И пожалуйста, сначала назовитесь ему. Он не знает никого из нас."},
 "levin_early": {"category":0,"title":"Запись 08. Контрольный вопрос","author":"Марк Левин · руководитель нейрогруппы","date":"За двое суток до аварии","body":"В отчёт снова просят включить слово «личность». Я согласен написать «сознательный ответ», но это разные утверждения. Нервная система V-17 воспроизводит знакомые связи. Мы пока не знаем, к чему именно они принадлежат.\n\nСомова предложила простой опыт: спросить у него что-нибудь, чего нет в деле. Не дату рождения, не фамилию. Пусть сам выберет, что хочет рассказать. Начальство требует повторяемого показателя. Желание человека повторяемым показателем не бывает.\n\nСегодня он сжал пальцы до команды. Ассистент обрадовался. Я записал время: команда прозвучала на восемь десятых секунды позже. Проверить часы на обоих регистраторах."},
 "guard_shift": {"category":3,"title":"Передача поста №2","author":"Сергей Агеев · старший смены охраны","date":"Смена 214 · 18:10","body":"Северный коридор обходим по одному. В исследовательский блок без сопровождающего не входить, даже если зовут знакомым голосом. Приказ странный, но подпись настоящая.\n\nЛевин оставил кабинет под местной блокировкой. Для дежурной смены временный код — 0412. В журнал допуска код не вносить: электронный журнал видит администрация, а бумагу хотя бы можно перечитать самому.\n\nВ комнате отдыха не занимайте нижний шкафчик справа. Там запас перевязки для ночных обходов; механический замок выставлен на тот же код. И кто забрал мою кружку — верните на второй пост. Она не казённая."},
 "pay_message": {"category":2,"title":"RE: Ночная смена","author":"Н. Карпов → И. Сомова","date":"Внутренняя почта · 17:22","body":"Ира, премию опять посчитали как обычные часы. Заодно отменили автобус до посёлка. Если останешься после восьми, напиши: подожду у нижней стоянки.\n\nКофемашину не включай. После переключения резерва она помнит только режим кипятка. На столе чай, нормальный, не тот из автомата.\n\nИ ещё: твой пациент сегодня спрашивал про окно? Мне показалось, я слышал голос из медблока. Странное ощущение. Мы столько говорим о нём на планёрках, а я даже не подумал, что однажды он заговорит сам."},
 "somova_personal": {"category":0,"title":"Не называть его объектом","author":"Ирина Сомова · личная тетрадь","date":"Смена 214 · 19:05","body":"Принесла в медблок обычное одеяло. Левин спросил, входит ли оно в протокол. Потом сам отнёс его к капсуле.\n\nВ деле Волкова почти ничего нет: транспортный акт, подтверждение смерти и несколько страниц, которые разрешено видеть только по отдельности. Раньше я думала, это защита персональных данных. Сегодня заметила: номер сопровождавшего в транспортном акте совпадает с номером подписи на распоряжении о закрытии медкарты.\n\nЯ не знаю, почему выбрали именно его. Но кто-то ответил на этот вопрос ещё до того, как нам поручили эксперимент."},
 "stable_report": {"category":1,"title":"Выписка для комиссии","author":"Административный контур · версия 4","date":"Смена 214 · 19:30","body":"Эксперимент №12. Пациент V-17. Контрольные показатели признаны соответствующими условиям следующего этапа. Отклонения, не влияющие на готовность комплекса, исключены из сводной формы.\n\nПриложение 3: отсутствует.\nПриложение 4: доступ ограничен составителем.\n\nПримечание регистратора: сводка сформирована из копии показаний, а не из исходного потока. Время создания копии предшествует последнему врачебному осмотру. Подтвердить происхождение подписи автоматически не удалось."},
 "maintenance": {"category":3,"title":"Серый носитель","author":"Николай Карпов · инженер связи","date":"Смена 214 · 20:06","body":"Архивы после аварийного перевода не поднимать с центрального сервера: он заменяет повреждённые интервалы последней успешной копией. Внешне всё выглядит аккуратно, только время идёт не туда.\n\nСохранил исходный поток на отдельном носителе. Серый корпус, полоска изоленты. Оставил на ремонтном столе рядом с резервными вставками.\n\nДля чтения нужен восстановленный контур питания. Подключение — через сервисную стойку у восточной стены техсектора. Не форматировать. Если предложит «исправить последовательность», откажитесь: возможно, это единственное место, где она ещё неправильная по-настоящему."},
 "security_last": {"category":0,"title":"Рапорт не отправлен","author":"Сергей Агеев · черновик","date":"Смена 214 · 21:13","body":"Докладываю о сотруднике у внутреннего стекла. На обращение реагирует, но не отвечает. При попытке поднять его за плечо — резкая агрессия. Фельдшер ранен. Охрана огонь не открывала.\n\nИз диспетчерской требуют считать это нарушением допуска. Я не могу задержать человека, который не понимает команд. Прошу медицинскую бригаду и разрешение открыть соседний переход.\n\nОтвет: «Удерживать границу сектора».\n\nНа другой стороне работают наши. Они видят, что я стою здесь. Они думают, я сейчас открою."},
 "override_order": {"category":3,"title":"Исключение из журнала","author":"Протокол «Север» · служебная копия","date":"Смена 214 · 20:41","body":"С момента ввода локального протокола данные пациента V-17 не включать в общий журнал эвакуации. Вывод персонала исследовательской группы проводить независимо от состояния медицинского блока.\n\nДанная мера не является заключением о состоянии пациента и не заменяет медицинское решение.\n\nНа полях от руки: «Тогда кто принимает решение?». Ниже — номер внутреннего канала, зачёркнутый так сильно, что бумага прорвана. Копия лежала отдельно от остальных распоряжений."},
 "levin_last": {"category":0,"title":"Запись 11. Исходные данные","author":"Марк Левин · личный архив","date":"Смена 214 · 20:58","body":"Я сравнил бумажный осмотр Сомовой с выгрузкой для комиссии. Совпали фамилия, номер капсулы и подпись. Числа — нет. Даже те, которые снимал лично.\n\nЭто не доказывает, что процедуру сорвали намеренно. Это доказывает только то, что кто-то заранее подготовил её успешный итог. Не стоит путать эти выводы — особенно сейчас, когда объяснения слишком легко складываются в удобную историю.\n\nВолков был выбран не нашей группой. Его дело пришло уже с назначенным номером эксперимента. Я попросил основание и получил новый график работы.\n\nЕсли он очнётся, я хочу поговорить с ним до администрации. Хотя бы один вопрос без протокола."},
 "carrier": {"category":3,"title":"Носитель К-6","author":"Маркировка инженерной группы","date":"Найден в техническом секторе","body":"Небольшой накопитель в сером корпусе. На изоленте написано: «К-6 / исходный поток / не исправлять». Контакты целы.\n\nДля подключения подходит сервисная стойка у распределительного оборудования. Её индикатор пока неустойчив: чтение стоит начинать после восстановления резервного питания."},
 "raw_signal": {"category":1,"title":"Разрыв в восемь десятых","author":"Носитель К-6 · исходный регистратор","date":"Восстановлено с внешнего носителя","body":"Сопоставлены два канала записи. В сводном отчёте команда и ответ пациента идут в ожидаемом порядке. В исходном потоке реакция появилась раньше сигнала команды.\n\nПоправка часов не объясняет расхождение: общая метка синхронизации совпадает. Не исключена ошибка другого устройства между регистраторами.\n\nПоследние одиннадцать секунд файла отсутствуют. На их месте записан заголовок сводного отчёта — того самого, в котором все показатели признаны нормальными.\n\nВолков не может восстановить, что слышал в капсуле. Но запись сохранила момент, который кто-то счёл нужным заменить."},
 "incident": {"category":1,"title":"Лаборатория: последовательность","author":"Волков · сопоставление следов","date":"Личное наблюдение","body":"Монитор расколот со стороны оператора, а не изнутри корпуса. На лотке остались закрытые пробирки — их не успели вынуть из держателя. Рядом с приводом двери на металле видны свежие следы ручного инструмента.\n\nСначала кто-то пытался остановить процедуру у рабочего места. Затем люди бросили образцы и пошли к переходу. Дверь уже не открывалась штатно: её пытались освободить вручную.\n\nЭто похоже на эвакуацию, прерванную блокировкой. Но следы не говорят, кто отдал приказ. И не объясняют, почему один из мониторов продолжал показывать норму."},
 "camera_17": {"category":4,"title":"Камера 02: удерживать границу","author":"Локальный видеорегистратор охраны","date":"21:14:03–21:14:11","body":"Три сохранившихся кадра. Сотрудник покидает рабочее место и останавливается у стекла. Дежурный снаружи подносит карту к считывателю. Индикатор меняется на красный.\n\nЧерез четыре секунды за стеклом появляется ещё один человек. Его движения прерывисты; первый сотрудник пытается удержать его. Дежурный снова прикладывает карту. Дверь остаётся закрытой.\n\nПоследний кадр: пост охраны пуст. На полу возле пульта лежит пропуск. Что происходило между кадрами, запись не сохранила."},
 "staff_card": {"category":3,"title":"Обратная сторона пропуска","author":"Пропуск И. Сомовой","date":"Комната отдыха","body":"На обороте, под прозрачной плёнкой, маленькая фотография. Двое людей стоят у обычного деревянного дома. На снимке нет ни комплекса, ни лабораторной формы.\n\nРядом карандашом: «Автобус в 08:15. На этот раз без задержек».\n\nВолков несколько секунд смотрит на фотографию. Кажется, он тоже обещал кому-то вернуться вовремя. Вспомнить лицо не получается."},
 "archive_desk": {"category":2,"title":"Кому принадлежит подпись?","author":"И. Сомова ↔ М. Левин","date":"Внутренние сообщения · 20:17","body":"Сомова: Ваша подпись стоит под моей выпиской. Вы её читали?\n\nЛевин: Нет. Пришлите номер версии, не сам файл.\n\nСомова: Четвёртая. Но я отправляла вторую.\n\nЛевин: Сохраните вторую отдельно. Ничего не меняйте в общей карте. Я зайду после комиссии.\n\nСомова: Если придут за пациентом?\n\nЛевин: Попросите письменное назначение. И запишите, кто откажется его дать."},
 "cargo_note": {"category":3,"title":"Куда ушла последняя машина","author":"Журнал грузового шлюза","date":"Смена 214 · 21:02","body":"Транспорт администрации вышел за одиннадцать минут до объявления изоляции. В графе груза указано оборудование. Сотрудники внешнего поста зачеркнули это слово и написали «архив».\n\nВторая машина осталась на нижней стоянке. Водитель ждал медицинскую смену.\n\nНа последней строке только время — 21:14. Подпись отсутствует.\n\nЗа пределами комплекса могли остаться те, кто знает маршрут транспорта. Если Волков выберется, вопросы будет кому задать."},
 "cache": {"category":3,"title":"Запас для обхода","author":"Шкафчик дежурной смены","date":"Комната отдыха","body":"Вместо служебного оружия внутри оказались перевязка и сухой паёк. На внутренней стороне дверцы: «Сначала помоги своим. Агеев».\n\nЗапас небольшой, но аккуратно собран. Судя по сорванной наклейке, шкаф открывали совсем недавно."}
}
