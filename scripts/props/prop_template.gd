# ============================================================
# PROP_TEMPLATE.GD — ШАБЛОН ДЛЯ НОВЫХ ОБЪЕКТОВ
#
# КАК СОЗДАТЬ НОВЫЙ ПРЕФАБ (например, «Бочка», «Колючка», «Сундук»):
#
#  1. В файловой панели Godot: ПКМ по scenes/props/PropTemplate.tscn
#     → «Дублировать» → назови MyThing.tscn.
#  2. ПКМ по scripts/props/prop_template.gd → «Дублировать» →
#     my_thing.gd. Открой MyThing.tscn и в корневом узле укажи
#     этот новый скрипт.
#  3. В корневом узле поменяй Class name: переименуй class_name
#     в скрипте (например, class_name BarbedWire) и поправь
#     имя корневого узла сцены.
#  4. Sprite: подставь свою текстуру (путь в assets/sprites/).
#  5. Collision: подгони форму/размер под объект
#     (круг — для стволов и бочек, прямоугольник — для стен).
#  6. Если объект должен ломаться от пуль: поставь галку
#     Destructible и задай Max HP в инспекторе.
#  7. Пиши логику ниже — доступны:
#       take_damage(amount, source)  — урон от пуль/взрывов
#       сигналы damaged(hp) / destroyed
#       группы: "props" (все объекты), "damageable" (ломаются)
#  8. Перетащи готовый .tscn из Файловой панели на сцену
#     локации — и расставляй сколько нужно. Один префаб —
#     сколько угодно экземпляров: правка префаба обновит ВСЕ
#     экземпляры сразу.
#
# НУЖЕН ОБЪЕКТ-ЗОНА (не блокирует движение, как куст/окоп)?
#   Тогда в корне сцены замени StaticBody2D на Area2D и за основу
#   скрипта возьми bush.gd или trench.gd (там готовый подсчёт
#   входов/выходов и работа с переменными юнита).
# ============================================================
class_name PropTemplate
extends PropBase

## пример экспорта: параметр появится в инспекторе у каждого экземпляра
@export var interact_hint: String = ""


func _ready() -> void:
	super()
	# Пример: реакция на разрушение
	destroyed.connect(func(): print("Префаб разрушен: ", name))
