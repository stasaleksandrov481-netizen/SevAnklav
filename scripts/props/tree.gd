# ============================================================
# TREE.GD — дерево (твёрдый префаб)
#
# Поведение:
#   • непроходимый ствол (маленький круг у основания) — игрок
#     и боты обходят его, крона проходу не мешает;
#   • по умолчанию НЕ разрушаем (скала/старое дерево). Хочешь
#     рубку/валимость — включи Destructible в инспекторе и
#     задай Max HP; пули начнут наносить урон через take_damage().
#
# Сцена: scenes/props/Tree.tscn
# Расставляй вручную: перетащи Tree.tscn из Файловой панели
# в сцену локации и сдвигай мышью.
# ============================================================
class_name TreeProp
extends PropBase


func _ready() -> void:
	super()
	# лёгкая случайная вариация, чтобы лес не выглядел клонированным
	if _sprite != null:
		_sprite.flip_h = randf() < 0.5
		var s := _sprite.scale.x * randf_range(0.92, 1.1)
		_sprite.scale = Vector2(s, s)
